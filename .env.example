# Copy to .env (never committed). Values here are placeholders only.
# Hugging Face: log in interactively instead of storing the token in a file:
#   docker exec -it sprint hf auth login
HF_HOME=/work/hf_home
HF_USER=your-hf-username
HF_DATASET_REPO=your-hf-username/so101-video2sim-data      # private dataset repo for generated episodes
HF_MODEL_REPO=your-hf-username/so101-video2sim-pi05         # private model repo for checkpoints
MUJOCO_GL=osmesa                                            # EGL does not work on the MI300X droplet
PYOPENGL_PLATFORM=osmesa
PIP_CONSTRAINT=/work/video2sim-so101/env/constraints.txt    # protects the ROCm torch build
SO101_TASK_SPEC=/work/video2sim-so101/demo/outputs/pexels_7488188_sugar_cube/so101_task_spec.json
